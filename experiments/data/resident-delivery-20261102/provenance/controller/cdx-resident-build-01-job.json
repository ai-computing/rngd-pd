{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "cdx-resident-build-01",
    "namespace": "codex-resident-delivery-20261102",
    "labels": {
      "owner": "codex",
      "experiment": "resident-delivery-build"
    }
  },
  "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 900,
    "ttlSecondsAfterFinished": 900,
    "template": {
      "metadata": {
        "labels": {
          "owner": "codex",
          "experiment": "resident-delivery-build"
        }
      },
      "spec": {
        "restartPolicy": "Never",
        "automountServiceAccountToken": false,
        "nodeSelector": {
          "kubernetes.io/hostname": "etri-001"
        },
        "containers": [
          {
            "name": "build",
            "image": "golang:1.25.1-bookworm",
            "imagePullPolicy": "IfNotPresent",
            "workingDir": "/work/onggi-source",
            "command": [
              "sh",
              "-c",
              "set -eu\ngo version > /work/evidence/go-version.txt\ngo test /work/stage/csi_call.go /work/stage/csi_call_test.go > /work/evidence/csi-client-tests.log 2>&1\ngo test ./pkg/csi > /work/evidence/onggi-csi-tests.log 2>&1\ngo build -mod=readonly -o /work/bin/csi-call /work/stage/csi_call.go > /work/evidence/client-build.log 2>&1\ngo build -mod=readonly -o /work/bin/onggi ./cmd/onggi > /work/evidence/onggi-build.log 2>&1\nsha256sum /work/bin/csi-call /work/bin/onggi > /work/evidence/binary-sha256.txt\necho completed > /work/evidence/build-status.txt\n"
            ],
            "env": [
              {
                "name": "GOCACHE",
                "value": "/work/go-cache"
              },
              {
                "name": "GOMODCACHE",
                "value": "/work/go-mod"
              }
            ],
            "resources": {
              "requests": {
                "cpu": "2",
                "memory": "4Gi"
              },
              "limits": {
                "cpu": "8",
                "memory": "16Gi"
              }
            },
            "securityContext": {
              "privileged": true
            },
            "volumeMounts": [
              {
                "name": "work",
                "mountPath": "/work"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "work",
            "hostPath": {
              "path": "/home/gspark/workspace/codex_resident_delivery_20261102",
              "type": "Directory"
            }
          }
        ]
      }
    }
  }
}
