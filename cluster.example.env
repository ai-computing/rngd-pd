# Site-specific values for the bench scripts. Copy to cluster.local.env (untracked)
# and fill in; variables already exported in the shell take precedence.

# llm-d gateway (Envoy) base URL; bench scripts append /rngd/llama8b-pd/completions
LLMD_GATEWAY_URL=http://<gateway-host>:<port>

# Optional: full completions URL, overrides LLMD_GATEWAY_URL + route
# PD_GATEWAY=http://<gateway-host>:<port>/rngd/llama8b-pd/completions

# Optional: how to run kubectl (bench/sweep_llmd.py reads pod->card mapping); default: kubectl
# KUBECTL_CMD=ssh -p <ssh-port> <user>@<control-node-ip> kubectl
