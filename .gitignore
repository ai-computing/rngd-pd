# Compiled NPU artifacts. These are build outputs keyed by graph hash — a
# 42 MB EDF per entry, regenerated by artifact_cache on a miss. The cache is
# shared with the pods through a hostPath mount, so it lives in the tree, but
# it is not source.
artifacts_cache/
*.edf
*.w
*.rbln

# Measurement results (*.jsonl) ARE tracked: they are a few KB each and they
# are the evidence behind every number in docs/, so a claim can be traced to
# the run that produced it.

__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# OMC session state, not source
.omc/

# run logs (results are kept as *.jsonl)
*.log

# site-specific endpoints (template: cluster.example.env)
cluster.local.env
